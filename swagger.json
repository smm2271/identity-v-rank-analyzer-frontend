    "/auth/register": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "以 Email + 密碼註冊",
        "description": "以 Email + 密碼註冊新帳號。\n\n(S) 單一職責：本函式僅協調各 Service 完成註冊流程，\n    密碼強度驗證委派給 PasswordLoginProvider，\n    使用者建立委派給 UserService。\n(D) 依賴反轉：密碼供應商透過 factory.get_password() 取得，\n    不直接依賴 PasswordLoginProvider 具體類別。",
        "operationId": "register_auth_register_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "以 Email + 密碼登入",
        "description": "以「Email 或 Username」+ 密碼登入。\n\n(S) 單一職責：本函式只負責 HTTP 層的流程協調，\n    帳密驗證完全委派給 PasswordLoginProvider.authenticate()。\n(D) 依賴反轉：密碼供應商透過 Factory 取得。\n\n安全考量：無論帳號不存在或密碼錯誤，統一回傳「帳號或密碼錯誤」，\n防止帳號列舉攻擊。",
        "operationId": "login_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
