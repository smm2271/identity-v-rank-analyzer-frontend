{
  "openapi": "3.1.0",
  "info": {
    "title": "Identity V Rank Analyzer API",
    "version": "0.1.0"
  },
  "paths": {
    "/auth/providers": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "列出可用的登入供應商",
        "description": "回傳所有已註冊的 OAuth 供應商名稱及密碼登入是否啟用。\n\n(O) 開放封閉：供應商列表由 Factory 動態提供，新增供應商後此端點自動反映。",
        "operationId": "list_providers_auth_providers_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProvidersResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/{provider}/authorize": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "取得 OAuth 授權 URL",
        "description": "產生指定 OAuth 供應商的授權 URL。\n\n(L) 里氏替換：無論是 Google 或 Discord，都透過相同的\n    OAuthLoginInterface.get_authorization_url() 呼叫，行為一致。\n\n前端應將使用者重導向至回傳的 authorization_url。\nstate 參數由後端產生，前端需在回呼時帶回以防 CSRF。",
        "operationId": "oauth_authorize_auth__provider__authorize_get",
        "parameters": [
          {
            "name": "provider",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Provider"
            }
          },
          {
            "name": "redirect_uri",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "OAuth 授權完成後的回呼 URL",
              "title": "Redirect Uri"
            },
            "description": "OAuth 授權完成後的回呼 URL"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OAuthAuthorizeResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/auth/{provider}/callback": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "OAuth 回呼處理",
        "description": "處理 OAuth 授權回呼。\n\n(S) 單一職責：本函式只做 HTTP 層的「請求解析 → 委派 Service → 回應組裝」。\n(L) 里氏替換：exchange_code / fetch_user_info 透過 OAuthLoginInterface 抽象呼叫，\n    Google 與 Discord 可無縫替換。\n(D) 依賴反轉：所有 Service 透過 Depends() 注入，不直接持有。\n\n流程：\n1. 以 authorization code 向供應商交換 tokens\n2. 以 access_token 取得使用者資訊\n3. 查詢 user_identities 是否已有此身份\n4. 若無 → 建立新使用者 + 身份\n5. 簽發 JWT access + refresh token",
        "operationId": "oauth_callback_auth__provider__callback_get",
        "parameters": [
          {
            "name": "provider",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Provider"
            }
          },
          {
            "name": "code",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "OAuth authorization code",
              "title": "Code"
            },
            "description": "OAuth authorization code"
          },
          {
            "name": "state",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "CSRF state 參數",
              "title": "State"
            },
            "description": "CSRF state 參數"
          },
          {
            "name": "redirect_uri",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "與 authorize 時使用的相同回呼 URL",
              "title": "Redirect Uri"
            },
            "description": "與 authorize 時使用的相同回呼 URL"
          },
          {
            "name": "link_token",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "待關聯 OAuth 流程 token（驗證模式使用）",
              "title": "Link Token"
            },
            "description": "待關聯 OAuth 流程 token（驗證模式使用）"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
