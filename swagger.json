  "components": {
    "schemas": {
      "ApiKeyCreateRequest": {
        "properties": {
          "name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 50
              },
              {
                "type": "null"
              }
            ],
            "title": "Name",
            "description": "API Key 顯示名稱（方便管理）"
          }
