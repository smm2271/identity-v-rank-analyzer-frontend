        "summary": "登出（僅撤銷當前 Session）",
        "description": "登出當前裝置，僅撤銷本次請求對應的 refresh token session。",
        "operationId": "logout_auth_logout_post",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        }
      }
    },
    "/users/me": {
      "get": {
        "tags": [
          "Users"
        ],
        "summary": "取得當前使用者資料",
        "description": "回傳當前已驗證使用者的基本資料。\n\n(D) 依賴反轉：使用者物件由 get_current_user 依賴注入，\n    不自行解析 token 或查詢資料庫。",
        "operationId": "get_me_users_me_get",
        "responses": {
